<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/textViewTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titre"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_poids"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editTextPoids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_poids"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_taille"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/editTextTaille"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_taille"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/buttonCalculer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bouton_calculer"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/buttonEffacer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/bouton_effacer" />

        <TextView
            android:id="@+id/textViewImc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resultat_initial"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="32dp" />

        <TextView
            android:id="@+id/textViewCategorie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/categorie_initiale"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
